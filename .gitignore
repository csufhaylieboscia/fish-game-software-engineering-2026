# Edited .gitignore to ignore virtual environment and Python cache files
venv/
__pycache__/
*.pyc
*.pyo
.python-version

echo venv/ >> .gitignore
echo __pycache__/ >> .gitignore
echo *.pyc >> .gitignore
echo .python-version >> .gitignore

# use git rm -r --cached venv/ to remove the virtual environment from tracking
